# Owned copies of the pinned source; never mutate the vendor checkout.
# Full is a diagnostic control, frozen at graph construction/model load.
file(READ "${LLAMA_SOURCE}/src/models/lfm2.cpp" lfm_source)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/decision-input.inc" head_input)
set(head_anchor "    // the question type is not a graph input, so the head is evaluated for each of them")
set(type_anchor "        ggml_tensor * type_row = ggml_view_1d(ctx0, model.type_embd, n_embd, it * model.type_embd->nb[1]);")
foreach(anchor IN ITEMS "${head_anchor}" "${type_anchor}" "    return scores;")
    string(FIND "${lfm_source}" "${anchor}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Pinned d1 head anchor changed: ${anchor}")
    endif()
endforeach()
string(REPLACE "static const uint32_t N_DECISION_TYPES = 3;" "static const uint32_t N_DECISION_TYPES = 3;\n${head_input}" lfm_source "${lfm_source}")
string(REPLACE "${head_anchor}" "    const bool full = getenv(\"HEIMDALL_D1_HEAD\") && std::string(getenv(\"HEIMDALL_D1_HEAD\")) == \"full\";\n    ggml_tensor * selected = nullptr;\n    if (!full) {\n        selected = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_tokens);\n        ggml_set_input(selected);\n        res->add_input(std::make_unique<heimdall_head_input>(selected));\n    }" lfm_source "${lfm_source}")
string(REPLACE "it < N_DECISION_TYPES;" "it < (full ? N_DECISION_TYPES : 1);" lfm_source "${lfm_source}")
string(REPLACE "${type_anchor}" "        ggml_tensor * type_row = full ? ggml_view_1d(ctx0, model.type_embd, n_embd, it * model.type_embd->nb[1]) : ggml_get_rows(ctx0, model.type_embd, selected);" lfm_source "${lfm_source}")
string(REPLACE "    return scores;" "    if (!full) scores = ggml_concat(ctx0, ggml_concat(ctx0, scores, scores, 0), scores, 0);\n    return scores;" lfm_source "${lfm_source}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/heimdall-lfm2.cpp" "${lfm_source}")
get_target_property(llama_sources llama SOURCES)
list(FILTER llama_sources EXCLUDE REGEX "models/lfm2.cpp$")
set_property(TARGET llama PROPERTY SOURCES "${llama_sources};${CMAKE_CURRENT_BINARY_DIR}/heimdall-lfm2.cpp")
target_include_directories(llama PRIVATE "${LLAMA_SOURCE}/src/models" "${CMAKE_CURRENT_SOURCE_DIR}")

# encode() normally forces every token to be an output. Honor marker flags for
# this memoryless decision model only; retain all input/context tokens.
file(READ "${LLAMA_SOURCE}/src/llama-context.cpp" llama_context_source)
string(FIND "${llama_context_source}" "int llama_context::encode(" encode_start)
string(FIND "${llama_context_source}" "template<typename T>\nstatic void copy_tensor_async_rows(" encode_end)
if(encode_start EQUAL -1 OR encode_end EQUAL -1)
    message(FATAL_ERROR "Pinned d1 encoder anchors changed")
endif()
math(EXPR encode_length "${encode_end} - ${encode_start}")
string(SUBSTRING "${llama_context_source}" 0 ${encode_start} before_encode)
string(SUBSTRING "${llama_context_source}" ${encode_start} ${encode_length} encode_source)
string(SUBSTRING "${llama_context_source}" ${encode_end} -1 after_encode)
string(REPLACE "if (!balloc->init(batch_inp, model.vocab, true))" "const bool sparse = model.arch == LLM_ARCH_LFM2 && hparams.n_layer_decision > 0 && cparams.pooling_type == LLAMA_POOLING_TYPE_NONE;\n    if (!balloc->init(batch_inp, model.vocab, !sparse))" encode_source "${encode_source}")
string(REPLACE "    // reserve output buffer" "    const uint32_t n_selected = balloc->get_n_outputs();\n    // reserve output buffer" encode_source "${encode_source}")
string(REPLACE "output_reserve(n_tokens) < n_tokens" "output_reserve(n_selected) < n_selected" encode_source "${encode_source}")
string(REPLACE "    for (uint32_t i = 0; i < n_tokens; ++i) {\n        output_ids[i] = i;\n    }\n\n    n_outputs = n_tokens;" "    const auto & out_ids = balloc->get_out_ids();\n    GGML_ASSERT(out_ids.size() == n_selected);\n    for (uint32_t i = 0; i < n_selected; ++i) output_ids[out_ids[i]] = i;\n    n_outputs = n_selected;" encode_source "${encode_source}")
string(REPLACE "n_tokens*n_embd_out" "n_selected*n_embd_out" encode_source "${encode_source}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/heimdall-llama-context.cpp" "${before_encode}${encode_source}${after_encode}")
get_target_property(llama_sources llama SOURCES)
list(FILTER llama_sources EXCLUDE REGEX "llama-context.cpp$")
set_property(TARGET llama PROPERTY SOURCES "${llama_sources};${CMAKE_CURRENT_BINARY_DIR}/heimdall-llama-context.cpp")

# Mark only option tokens for output. The last head layer's FFN and scorer then
# run on those rows; the encoder and all required attention context stay intact.
set(output_anchor "/* output    = */ slot.need_embd(),")
set(output_select "/* output    = */ heimdall_output_token(slot, slot.prompt.n_tokens()),")
set(slot_helpers "    bool heimdall_output_token(const server_slot & slot, int32_t pos) const {\n        if (slot.task->type != SERVER_TASK_TYPE_DECISION || slot.task->decision.markers.empty() ||\n            (getenv(\"HEIMDALL_D1_OUTPUT\") && std::string(getenv(\"HEIMDALL_D1_OUTPUT\")) == \"full\")) return slot.need_embd();\n        const auto & markers = slot.task->decision.markers;\n        return std::find(markers.begin(), markers.end(), pos) != markers.end() || pos == slot.task->decision.pointer;\n    }\n\n")
string(REPLACE "    bool add_prompt_mixed(server_slot & slot) {" "${slot_helpers}    bool add_prompt_mixed(server_slot & slot) {" context_source "${context_source}")
string(REPLACE "${output_anchor}" "${output_select}" context_source "${context_source}")
# Both ordinary text and mixed media pass this point. Never set the column on
# the submitting thread: its thread-local state is distinct from the worker's.
string(REPLACE "                    if (use_mixed_batch() && !slot.can_split() && input_tokens.has_mtmd) {" "                    if (slot.task->type == SERVER_TASK_TYPE_DECISION) heimdall_decision_column(slot.id, slot.task->decision.column);\n                    if (use_mixed_batch() && !slot.can_split() && input_tokens.has_mtmd) {" context_source "${context_source}")
# The old readback assumed a contiguous suffix. Sparse outputs need actual
# prompt positions (including media positions) paired with their batch indices.
set(readback_anchor "            const int32_t pos_first = slot.prompt.n_tokens() - (int32_t) idx.size();\n            auto get_embd = [&](int32_t pos) -> const float * {\n                const int32_t i = pos - pos_first;\n                return i >= 0 && i < (int32_t) idx.size() ? llama_get_embeddings_ith(slot.ctx_tgt, idx[i]) : nullptr;\n            };")
string(FIND "${context_source}" "${readback_anchor}" found)
if(found EQUAL -1)
    message(FATAL_ERROR "Pinned d1 sparse readback anchor changed")
endif()
string(REPLACE "${readback_anchor}" "            auto get_embd = [&](int32_t pos) -> const float * {\n                for (const int32_t i : idx) {\n                    if (batch.tokens[i].pos[0] == pos) return llama_get_embeddings_ith(slot.ctx_tgt, i);\n                }\n                return nullptr;\n            };" context_source "${context_source}")
string(REPLACE "pos, slot.need_embd(), /* is_prompt */ true" "pos, (slot.task->type != SERVER_TASK_TYPE_DECISION || slot.task->decision.markers.empty() || (getenv(\"HEIMDALL_D1_OUTPUT\") && std::string(getenv(\"HEIMDALL_D1_OUTPUT\")) == \"full\")) && slot.need_embd(), /* is_prompt */ true" context_source "${context_source}")

# Opt-in coarse timing, without the per-node profile's forced synchronizations.
string(PREPEND context_source "#include \"request-media.h\"\n")
string(REPLACE "        const json state = decision.parse_state(body, files);" "        const json state = decision.parse_state(body, files);\n        auto native_pcm = req.files.find(\"heimdall_pcm\");\n        if (native_pcm != req.files.end()) {\n            if (!files.empty()) throw std::invalid_argument(\"PCM upload and JSON media are exclusive\");\n            files.push_back(native_pcm->second.data);\n        }" context_source "${context_source}")
string(REPLACE "    void * heimdall_owner = nullptr;" "    void * heimdall_owner = nullptr;\n    heimdall_media_embeddings heimdall_media_cache;" context_source "${context_source}")
string(REPLACE "        std::unique_lock<std::recursive_mutex> ownership(heimdall_native_mutex());" "        std::unique_lock<std::recursive_mutex> ownership(heimdall_native_mutex());\n        heimdall_request_media media_scope(ctx_server.heimdall_media_cache, ctx_server.heimdall_owner);" context_source "${context_source}")
set(embd_anchor "            float * embd = slot.mbatch ? mtmd_batch_get_output_embd(slot.mbatch.get(), chunk.get()) : nullptr;")
string(FIND "${context_source}" "${embd_anchor}" found)
if(found EQUAL -1)
    message(FATAL_ERROR "Pinned d1 media embedding anchor changed")
endif()
string(REPLACE "${embd_anchor}" "${embd_anchor}\n            const char * chunk_id = mtmd_input_chunk_get_id(chunk.get());\n            const bool share_media = slot.task->type == SERVER_TASK_TYPE_DECISION && chunk_id && *chunk_id && !(getenv(\"HEIMDALL_D1_MEDIA\") && std::string(getenv(\"HEIMDALL_D1_MEDIA\")) == \"repeat\");\n            if (share_media) {\n                auto hit = heimdall_media_cache.find(chunk_id);\n                if (hit != heimdall_media_cache.end()) embd = hit->second.data();\n            }" context_source "${context_source}")
set(encoded_anchor "                embd = res == 0 ? mtmd_batch_get_output_embd(slot.mbatch.get(), chunk.get()) : nullptr;")
string(REPLACE "${encoded_anchor}" "${encoded_anchor}\n                if (embd && share_media) {\n                    if (!heimdall_metal_synchronize_owned(heimdall_owner, false)) throw std::runtime_error(\"HEIMDALL_GPU_FAULT: media encoding failed\");\n                    const auto count = mtmd_input_chunk_get_n_tokens(chunk.get()) * batch.n_embd;\n                    auto & cached = heimdall_media_cache[chunk_id];\n                    cached.assign(embd, embd + count);\n                    embd = cached.data();\n                }" context_source "${context_source}")
string(REPLACE "    void * heimdall_owner = nullptr;" "    void * heimdall_owner = nullptr;\n    double heimdall_media_ms = 0, heimdall_encode_ms = 0, heimdall_readback_ms = 0;" context_source "${context_source}")
string(REPLACE "        std::unique_lock<std::recursive_mutex> ownership(heimdall_native_mutex());" "        std::unique_lock<std::recursive_mutex> ownership(heimdall_native_mutex());\n        const bool heimdall_timing = getenv(\"HEIMDALL_D1_LATENCY\") != nullptr;\n        const auto heimdall_start = ggml_time_us();\n        double heimdall_prepare_ms = 0;\n        ctx_server.heimdall_media_ms = ctx_server.heimdall_encode_ms = ctx_server.heimdall_readback_ms = 0;" context_source "${context_source}")
string(REPLACE "            rd.post_tasks(std::move(tasks));\n            ownership.unlock();" "            heimdall_prepare_ms = (ggml_time_us() - heimdall_start) / 1000.0;\n            rd.post_tasks(std::move(tasks));\n            ownership.unlock();" context_source "${context_source}")
string(REPLACE "                    res = encode_mtmd_chunk(slot, slot.mbatch, cur_token_idx);" "                    const auto begin = ggml_time_us();\n                    res = encode_mtmd_chunk(slot, slot.mbatch, cur_token_idx);\n                    heimdall_media_ms += (ggml_time_us() - begin) / 1000.0;" context_source "${context_source}")
string(REPLACE "                bool ok = decode(n_batch, off);" "                const auto heimdall_encode_start = ggml_time_us();\n                bool ok = decode(n_batch, off);\n                heimdall_encode_ms += (ggml_time_us() - heimdall_encode_start) / 1000.0;" context_source "${context_source}")
string(REPLACE "    void send_decision(const server_slot & slot, const common_batch & batch, int32_t i_batch) {" "    void send_decision(const server_slot & slot, const common_batch & batch, int32_t i_batch) {\n        const auto heimdall_readback_start = ggml_time_us();" context_source "${context_source}")
string(REPLACE "        SLT_DBG(slot, \"%s\", \"sending decision result\\n\");" "        heimdall_readback_ms += (ggml_time_us() - heimdall_readback_start) / 1000.0;\n        SLT_DBG(slot, \"%s\", \"sending decision result\\n\");" context_source "${context_source}")
string(REPLACE "            answers[question.id] = decision.format_answer(question, scores, !files.empty());" "            answers[question.id] = decision.format_answer(question, scores, !files.empty());\n            if (heimdall_timing) answers[question.id][\"heimdall_raw_scores\"] = scores;" context_source "${context_source}")
# Patch just the decision route's terminal response, distinguished by its next
# route anchor, to snapshot worker counters under the same native ownership.
set(terminal "        return res;\n    };\n\n    this->get_lora_adapters")
string(REPLACE "${terminal}" "        if (heimdall_timing) {\n            heimdall_native_scope timing_ownership(ctx_server.heimdall_owner);\n            auto out = json::parse(res->data);\n            out[\"heimdall_latency\"] = {{\"prepare_ms\", heimdall_prepare_ms}, {\"media_encode_ms\", ctx_server.heimdall_media_ms}, {\"graph_submit_ms\", ctx_server.heimdall_encode_ms}, {\"readback_wait_ms\", ctx_server.heimdall_readback_ms}};\n            res->data = out.dump();\n        }\n        return res;\n    };\n\n    this->get_lora_adapters" context_source "${context_source}")
