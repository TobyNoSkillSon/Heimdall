file(READ "${LLAMA_SOURCE}/tools/mtmd/mtmd-audio.cpp" audio_source)
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/audio-fft.inc" audio_fft)
set(audio_anchor "static void fft(const mtmd_audio_cache & cache, float * in, int N, float * out) {\n    fft_impl<false, true>(cache, in, N, out);")
string(FIND "${audio_source}" "${audio_anchor}" audio_found)
if(audio_found EQUAL -1)
    message(FATAL_ERROR "Pinned d1 audio FFT anchor changed")
endif()
string(REPLACE "${audio_anchor}" "static void fft(const mtmd_audio_cache & cache, float * in, int N, float * out) {\n    if (heimdall_audio_fft(in, N, out)) return;\n    fft_impl<false, true>(cache, in, N, out);" audio_source "${audio_source}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/heimdall-audio.cpp" "${audio_fft}\n${audio_source}")
get_target_property(mtmd_sources mtmd SOURCES)
list(FILTER mtmd_sources EXCLUDE REGEX "mtmd-audio.cpp$")
set_property(TARGET mtmd PROPERTY SOURCES "${mtmd_sources};${CMAKE_CURRENT_BINARY_DIR}/heimdall-audio.cpp")
target_link_libraries(mtmd PRIVATE "-framework Accelerate")
